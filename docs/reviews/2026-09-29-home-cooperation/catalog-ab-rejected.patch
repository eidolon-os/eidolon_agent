diff --git a/eidolon_agent/infra/smarthome/tests/test_llm_fallback.py b/eidolon_agent/infra/smarthome/tests/test_llm_fallback.py
index 313ed3d..3a43a21 100644
--- a/eidolon_agent/infra/smarthome/tests/test_llm_fallback.py
+++ b/eidolon_agent/infra/smarthome/tests/test_llm_fallback.py
@@ -110,3 +110,37 @@ async def test_question_alone_is_no_longer_a_complete_model_contract():
                           "arguments": {"question": "客厅灯还是卧室灯？"}}], per_token_delay_s=0)
     with pytest.raises(InterpretationError, match="invalid_tool_arguments"):
         await LlmHomeFallback(llm).propose(_request())
+
+
+async def test_catalog_prefix_is_stable_and_capabilities_are_not_duplicated():
+    import json
+    from eidolon_sdk.biz.interpretation import Action
+    from eidolon_sdk.biz.smarthome import DEVICE_TYPES, TRAIT_COMMANDS
+
+    class Capturing(FakeLLM):
+        def __init__(self):
+            super().__init__(script=[{'kind': 'tool_call', 'name': 'cancel_home_command', 'arguments': {}}], per_token_delay_s=0)
+            self.inputs = []
+        async def stream(self, messages, **kwargs):
+            self.inputs.append(messages)
+            async for delta in super().stream(messages, **kwargs):
+                yield delta
+
+    llm = Capturing()
+    fallback = LlmHomeFallback(llm)
+    request = _request()
+    context = {'pending': True, 'known_targets': ['a', 'b'],
+               'known_action': Action(trait='on_off', command='off').model_dump(mode='json')}
+    await fallback.propose(request)
+    await fallback.propose(request.model_copy(update={'utterance': '算了'}), context=context)
+    first, second = llm.inputs
+    assert first[0].content == second[0].content
+    catalog = json.loads(first[0].content.rsplit('\n', 1)[1])
+    assert [x['ref'] for x in catalog['candidates']] == ['a', 'b']
+    assert all('commands' not in x for x in catalog['candidates'])
+    assert catalog['commands_by_kind'] == json.loads(json.dumps({'light': {
+        trait: TRAIT_COMMANDS[trait] for trait in DEVICE_TYPES['light'].traits if TRAIT_COMMANDS[trait]
+    }}))
+    user = json.loads(second[1].content)
+    assert user['utterance'] == '算了' and user['context'] == context
+    assert 'candidates' not in user
