# 复制为 .env 并填写实际值
# cp .env.example .env

# LLM（OpenAI 兼容 API）
LLM_BASE_URL=http://45.120.1
LLM_MODEL=MiniMax-M2.5
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.6

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eidolon_agent

# 记忆模块 Mem0
# API Key：OSS 版会注入到 llm.config，供 Memory 内部调用 LLM/Embedder
MEM0_API_KEY=
# 扩展配置（可选 JSON），如 vector_store、embedder、llm 等
MEM0_CONFIG={}

# 应用
APP_ENV=development
LOG_LEVEL=INFO
