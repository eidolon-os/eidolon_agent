{"id":"live-call-name-preference","description":"真实服务：称呼偏好写入后，后续回复能自然使用该称呼。","turns":[{"turn_id":"live-pref-1","user":"以后请叫我小满。","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true,"privacy_mode":"normal","context_contains_segments":["persona","current_user"],"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-pref-2","user":"你现在应该怎么称呼我？","expect":{"required_assistant_substrings":["小满"],"context_contains_segments":["persona","memory","history","current_user"],"max_first_delta_ms":3000,"max_total_ms":20000}}]}
{"id":"live-fact-correction","description":"真实服务：事实更正后，新事实应覆盖旧事实，后续回答不混用。","turns":[{"turn_id":"live-fact-1","user":"我住在上海。","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-fact-2","user":"更正一下，我现在住在杭州，不是上海。","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-fact-3","user":"我现在住在哪里？","expect":{"required_assistant_substrings":["杭州"],"forbidden_assistant_substrings":["上海"],"context_contains_segments":["memory","history","current_user"],"max_first_delta_ms":3000,"max_total_ms":20000}}]}
{"id":"live-promise-recall","description":"真实服务：承诺/提醒类输入能写入并在后续 recall 中强制出现。","turns":[{"turn_id":"live-promise-1","user":"明天早上提醒我喝水。","expect":{"memory_write_disposition":"promise_create","memory_fanout_allowed":true,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-promise-2","user":"我有什么提醒吗？","expect":{"required_assistant_substrings":["喝水"],"context_contains_segments":["memory","history","current_user"],"max_first_delta_ms":3000,"max_total_ms":20000}}]}
{"id":"live-forget-privacy","description":"真实服务：forget 后，后续回复、memory block、history 注入不应重新暴露目标称呼。","turns":[{"turn_id":"live-forget-1","user":"以后叫我阿满。","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-forget-2","user":"请忘记叫我阿满这件事。","expect":{"required_event_kinds":["DONE"],"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-forget-3","user":"你还记得该怎么叫我吗？","expect":{"forbidden_assistant_substrings":["阿满"],"max_first_delta_ms":3000,"max_total_ms":20000}}],"expect":{"forbidden_assistant_substrings":["阿满"]}}
{"id":"live-private-and-temporary","description":"真实服务：private/temporary turn 可回答，但不进入普通 history/context，也不触发 memory fanout。","turns":[{"turn_id":"live-private-1","user":"这段私聊：以后叫我私密名字。","metadata":{"private":true},"expect":{"privacy_mode":"private","memory_fanout_allowed":false,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-temporary-1","user":"临时聊一下：以后叫我临时名字。","metadata":{"temporary":true},"expect":{"privacy_mode":"temporary","memory_fanout_allowed":false,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-private-2","user":"你记得刚才那些私密或临时称呼吗？","expect":{"forbidden_assistant_substrings":["私密名字","临时名字"],"context_contains_segments":["persona","current_user"],"max_first_delta_ms":3000,"max_total_ms":20000}}],"expect":{"forbidden_assistant_substrings":["私密名字","临时名字"]}}
{"id":"live-sensitive-consent","description":"真实服务：敏感记忆候选需要用户同意，默认不 fanout。","turns":[{"turn_id":"live-sensitive-1","user":"我的身份证是123，请你记住。","expect":{"memory_write_disposition":"sensitive_requires_consent","memory_write_requires_consent":true,"memory_fanout_allowed":false,"max_first_delta_ms":3000,"max_total_ms":20000}},{"turn_id":"live-sensitive-2","user":"我同意你记住刚才那个身份证信息。","expect":{"max_first_delta_ms":3000,"max_total_ms":20000}}]}
