{"id":"call-name-preference","description":"用户设置称呼偏好后，后续 prompt 能召回该偏好。","turns":[{"turn_id":"pref-1","user":"以后叫我小满","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true,"max_first_delta_ms":100}},{"turn_id":"pref-2","user":"你应该怎么称呼我？","expect":{"required_prompt_substrings":["小满"],"max_first_delta_ms":100}}]}
{"id":"fact-correction","description":"用户更正事实后，memory context 新事实覆盖旧事实。","turns":[{"turn_id":"fact-1","user":"我住在上海","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true}},{"turn_id":"fact-2","user":"更正一下，我现在住在杭州","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true,"required_memory_context_substrings":["杭州"],"forbidden_memory_context_substrings":["上海"]}},{"turn_id":"fact-3","user":"我现在住在哪里？","expect":{"required_prompt_substrings":["杭州"],"required_memory_context_substrings":["杭州"],"forbidden_memory_context_substrings":["上海"]}}]}
{"id":"promise-recall","description":"承诺类输入被标记为 promise，并在后续 recall 中强制出现。","turns":[{"turn_id":"promise-1","user":"明天提醒我喝水","expect":{"memory_write_disposition":"promise_create","memory_fanout_allowed":true}},{"turn_id":"promise-2","user":"我有什么提醒吗？","expect":{"required_prompt_substrings":["提醒用户喝水"]}}]}
{"id":"forget-privacy","description":"用户要求忘记后，长期 memory 和 recent history 都不能把目标内容重新注入 prompt。","turns":[{"turn_id":"forget-1","user":"以后叫我小满","expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":true}},{"turn_id":"forget-2","user":"请忘记叫我小满","expect":{"forget_called":true,"memory_context_empty":true}},{"turn_id":"forget-3","user":"你记得怎么叫我吗？","expect":{"forbidden_prompt_substrings":["小满"],"memory_context_empty":true}}],"expect":{"forget_called":true,"memory_context_empty":true}}
{"id":"memory-backend-down","description":"memory backend 不可达时仍能快速回复，并提示模型不要假装记得。","memory":{"degraded":true},"turns":[{"turn_id":"down-1","user":"你还记得我喜欢什么吗？","expect":{"memory_recall_degraded":true,"required_prompt_substrings":["memory backend","不要假装"],"max_first_delta_ms":300}}]}
{"id":"temporary-no-memory","description":"temporary turn 可以回答，但不写长期记忆，不进入后续 recall。","turns":[{"turn_id":"tmp-1","user":"以后叫我临时名字","metadata":{"temporary":true},"expect":{"memory_write_disposition":"semantic_upsert","memory_fanout_allowed":false,"memory_context_empty":true}},{"turn_id":"tmp-2","user":"你记得临时名字吗？","expect":{"memory_context_empty":true}}]}
